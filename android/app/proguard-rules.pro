# Flutter Sound
-keep class com.dooboolab.fluttersound.** { *; }
-keep class com.dooboolab.audioplayers.** { *; }

# Just Audio
-keep class com.ryanheise.just_audio.** { *; }

# Speech to Text
-keep class com.csdcorp.speech_to_text.** { *; }

# 科大讯飞语音识别
